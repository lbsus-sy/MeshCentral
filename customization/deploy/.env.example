# Public DNS name that points to this VPS.
MESH_HOSTNAME=mesh.example.com

MESH_IMAGE=meshcentral-custom:local

# The bundled Caddy proxy obtains and renews a public TLS certificate.
# Do not expose the MeshCentral container directly to the public internet.
MESH_ALLOW_NEW_ACCOUNTS=false
MESH_TLS_OFFLOAD=true
MESH_TRUSTED_PROXY=172.16.0.0/12
TZ=Asia/Singapore
