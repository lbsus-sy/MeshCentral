# Public DNS name used by MeshCentral certificates/config.
MESH_HOSTNAME=mesh.example.com

# Local image tag built from this fork. Pin a versioned tag for release deployments.
MESH_IMAGE=meshcentral-custom:local

# Host ports; use 443/80 directly only when this host owns those ports.
MESH_HTTPS_PORT=443
MESH_HTTP_PORT=80

# Account creation: keep false after initial administrator bootstrap.
MESH_ALLOW_NEW_ACCOUNTS=false

# Direct TLS is the default. Set true only when a trusted reverse proxy terminates TLS.
MESH_TLS_OFFLOAD=false

# Optional JSON value accepted by MeshCentral's trustedProxy config, e.g. ["127.0.0.1"].
# Use the actual proxy address/CIDR list for your topology; never trust arbitrary clients.
MESH_TRUSTED_PROXY=

# Container timezone (IANA name)
TZ=Asia/Singapore
