# Public DNS name used by MeshCentral certificates/config
MESH_HOSTNAME=mesh.example.com

# Local image tag built from this fork
MESH_IMAGE=meshcentral-custom:local

# Host ports; use 443/80 directly only when this host owns those ports.
MESH_HTTPS_PORT=443
MESH_HTTP_PORT=80

# Account creation: enable only during controlled first-user bootstrap if needed.
MESH_ALLOW_NEW_ACCOUNTS=false

# Reverse proxy mode: set to true only when TLS is terminated by a trusted proxy.
MESH_TLS_OFFLOAD=false
# Optional trusted proxy IP/CIDR; leave empty unless you know the proxy address.
MESH_TRUSTED_PROXY=

# Container timezone (IANA name)
TZ=Asia/Singapore
