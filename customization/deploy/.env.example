# Public DNS name used by MeshCentral certificates/config.
MESH_HOSTNAME=mesh.example.com

MESH_IMAGE=meshcentral-custom:local
MESH_HTTPS_PORT=443
MESH_HTTP_PORT=80

# Disable creation after the administrator is bootstrapped.
MESH_ALLOW_NEW_ACCOUNTS=false

# false for direct TLS; true or a trusted proxy address for TLS offload.
MESH_TLS_OFFLOAD=false

# Optional comma-separated trusted proxy IP/domain list.
MESH_TRUSTED_PROXY=
TZ=Asia/Singapore
